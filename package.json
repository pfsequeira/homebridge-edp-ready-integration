{
  "name": "homebridge-edp-ready-integration",
  "displayName": "EDP Solar re:dy",
  "version": "1.0.0",
  "description": "Unofficial Homebridge plugin that shows realtime solar production, home consumption, grid import and grid export from an EDP Solar / re:dy account in HomeKit, with Eve power and history, plus optional Matter energy for the iOS Home app.",
  "author": "Francisco Sequeira (pfsequeira)",
  "license": "MIT",
  "homepage": "https://github.com/pfsequeira/homebridge-edp-ready-integration#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pfsequeira/homebridge-edp-ready-integration.git"
  },
  "bugs": {
    "url": "https://github.com/pfsequeira/homebridge-edp-ready-integration/issues"
  },
  "keywords": [
    "edp",
    "edp-solar",
    "energy",
    "eve",
    "homebridge",
    "homebridge-plugin",
    "homekit",
    "matter",
    "power-meter",
    "redy",
    "solar"
  ],
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity": "^3.600.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.600.0",
    "fakegato-history": "^0.6.5",
    "mqtt": "^5.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.14.0",
    "homebridge": "^1.11.4",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
