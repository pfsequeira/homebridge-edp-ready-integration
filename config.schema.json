{
  "pluginAlias": "EdpSolar",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Unofficial, read-only plugin. Shows realtime solar production, home consumption, grid import and grid export from your EDP Solar / re:dy account (EDP cloud) in HomeKit.",
  "footerDisplay": "Credentials are only sent to EDP's login service and are never logged. See the [README](https://github.com/pfsequeira/homebridge-edp-ready-integration#readme) for details.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "EDP Solar",
        "required": true
      },
      "email": {
        "title": "EDP Solar account email",
        "type": "string",
        "required": true,
        "format": "email"
      },
      "password": {
        "title": "EDP Solar account password",
        "type": "string",
        "required": true,
        "x-schema-form": {
          "type": "password"
        }
      },
      "threshold": {
        "title": "\"On\" threshold (W)",
        "type": "number",
        "default": 10,
        "minimum": 0,
        "description": "An outlet shows as on when its power is above this value. Useful for automations, e.g. Grid Export on = exporting to the grid."
      },
      "luxSensors": {
        "title": "Create light sensors (lux = watts) for Apple Home automations",
        "type": "boolean",
        "default": true
      },
      "hide_consumed": {
        "title": "Hide Home Consumption",
        "type": "boolean",
        "default": false
      },
      "hide_produced": {
        "title": "Hide Solar Production",
        "type": "boolean",
        "default": false
      },
      "hide_fromGrid": {
        "title": "Hide Grid Import",
        "type": "boolean",
        "default": false
      },
      "hide_injected": {
        "title": "Hide Grid Export",
        "type": "boolean",
        "default": false
      },
      "names": {
        "title": "Accessory names (optional)",
        "type": "object",
        "description": "Leave empty to keep the current names. New accessories default to the English names shown.",
        "properties": {
          "consumed": { "title": "Home consumption", "type": "string", "placeholder": "Home Consumption" },
          "produced": { "title": "Solar production", "type": "string", "placeholder": "Solar Production" },
          "fromGrid": { "title": "Grid import", "type": "string", "placeholder": "Grid Import" },
          "injected": { "title": "Grid export", "type": "string", "placeholder": "Grid Export" }
        }
      },
      "matter": {
        "title": "Matter (iOS 27 Energy)",
        "type": "object",
        "properties": {
          "enabled": {
            "title": "Enable Matter mode (requires Homebridge >= 2.3 and Matter enabled on this plugin's child bridge)",
            "type": "boolean",
            "default": false
          },
          "exposeProduction": {
            "title": "Experimental: also expose Solar Production as a Matter outlet (negative power / exported energy)",
            "type": "boolean",
            "default": false
          }
        }
      }
    }
  },
  "layout": [
    "name",
    "email",
    "password",
    "threshold",
    "luxSensors",
    {
      "type": "fieldset",
      "title": "Accessories",
      "expandable": true,
      "items": ["hide_consumed", "hide_produced", "hide_fromGrid", "hide_injected", "names.consumed", "names.produced", "names.fromGrid", "names.injected"]
    },
    {
      "type": "fieldset",
      "title": "Matter",
      "expandable": true,
      "items": ["matter.enabled", "matter.exposeProduction"]
    }
  ]
}
